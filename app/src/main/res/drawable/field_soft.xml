<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/white" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/orange" />
            <padding android:left="13dp" android:top="9dp" android:right="13dp" android:bottom="9dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_soft" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/border_soft" />
            <padding android:left="13dp" android:top="9dp" android:right="13dp" android:bottom="9dp" />
        </shape>
    </item>
</selector>
