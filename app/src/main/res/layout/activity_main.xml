<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="17dp"
        android:paddingEnd="20dp"
        android:paddingBottom="17dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Baixa da Shopee"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/summaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Nenhuma lista carregada"
            android:textColor="#FFF1EC"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/overlayPermissionChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/chip_neutral"
                android:gravity="center"
                android:text="○ Sobreposição"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space android:layout_width="7dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/accessibilityPermissionChip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/chip_neutral"
                android:gravity="center"
                android:text="○ Acessibilidade"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Space android:layout_width="7dp" android:layout_height="1dp" />

            <TextView
                android:id="@+id/openPanelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_neutral"
                android:gravity="center"
                android:text="▶ Painel"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seu nome para o preenchimento"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/receiverNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_soft"
                    android:hint="Nome autorizado do recebedor"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/ink"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:textColorHint="@color/muted" />

                <Button
                    android:id="@+id/saveNameButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/button_primary"
                    android:text="Salvar nome"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/scanQrButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_secondary"
                android:text="▣  Escanear QR Code offline"
                android:textAllCaps="false"
                android:textColor="@color/orange_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/importButton"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:background="@drawable/button_primary"
                    android:text="＋ Importar Excel/CSV"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <Space android:layout_width="9dp" android:layout_height="1dp" />

                <Button
                    android:id="@+id/moreButton"
                    android:layout_width="72dp"
                    android:layout_height="54dp"
                    android:background="@drawable/button_secondary"
                    android:contentDescription="Mais ferramentas"
                    android:text="•••"
                    android:textAllCaps="false"
                    android:textColor="@color/orange_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/selectedDeliveryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/panel"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTREGA SELECIONADA"
                    android:textColor="@color/orange_dark"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/currentDeliveryText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Importe uma lista para começar."
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/packagePhotoButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_primary"
                        android:text="Foto do pacote"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <Space android:layout_width="8dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/facadePhotoButton"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_primary"
                        android:text="Foto da fachada"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/packagePreview"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1"
                        android:contentDescription="Prévia da foto do pacote"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <ImageView
                        android:id="@+id/facadePreview"
                        android:layout_width="0dp"
                        android:layout_height="92dp"
                        android:layout_weight="1"
                        android:contentDescription="Prévia da foto da fachada"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/linkHouseButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:text="Vincular casa"
                        android:textAllCaps="false"
                        android:textColor="@color/orange_dark"
                        android:textStyle="bold" />
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <Button
                        android:id="@+id/navigationButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/button_secondary"
                        android:text="Abrir no mapa"
                        android:textAllCaps="false"
                        android:textColor="@color/orange_dark"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/useInKeyboardButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/button_secondary"
                    android:text="Começar o teclado nesta entrega"
                    android:textAllCaps="false"
                    android:textColor="@color/orange_dark"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/button_secondary"
                    android:text="Exportar códigos + nomes + endereços"
                    android:textAllCaps="false"
                    android:textColor="@color/orange_dark"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/generatePdfButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/button_primary"
                    android:text="Gerar PDF desta entrega"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/deliverySection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/deliverySectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Entregas da rota"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Toque numa entrega para selecioná-la"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/deliveryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
