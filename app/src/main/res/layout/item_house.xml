<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/houseThumbnail"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="#EEE"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/houseDisplayName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Casa de João"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/houseAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rua A, 123"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/houseResidents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Moradores: João • Maria"
            android:textColor="@color/ink"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/houseEditBtn"
        android:layout_width="wrap_content"
        android:layout_height="38dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/button_secondary"
        android:text="Editar"
        android:textAllCaps="false"
        android:textColor="@color/orange_dark"
        android:textSize="12sp" />
</LinearLayout>
