<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/completedCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BR261008765178U"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/completedCustomer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="JOÃO DAS DORES"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/completedAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Rua X, 123 - Cabuçu"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/completedUndoButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/button_secondary"
        android:minWidth="80dp"
        android:text="Desfazer"
        android:textAllCaps="false"
        android:textColor="@color/orange_dark"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
